{
  "name": "webworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based Minecraft world editor \u2014 a lightweight WorldEdit with AI-assisted building.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:list": "node scripts/fetch-assets.mjs --list"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "yauzl-promise": "^4.0.0"
  }
}
